     1 				; ============================================================================
     2 				; FujiNet N: Device SIO Layer
     3 				; ============================================================================
     4
     5 = 0071			FN_DEVID       = $71
     6 = 0001			FN_UNIT        = 1
     7 3E62 01			fn_cur_unit    dta FN_UNIT     ; current N: unit (1=page, 2=image)
     8 = 004F			FN_CMD_OPEN    = 'O'
     9 = 0043			FN_CMD_CLOSE   = 'C'
    10 = 0052			FN_CMD_READ    = 'R'
    11 = 0053			FN_CMD_STATUS  = 'S'
    12 = 0040			SIO_READ       = $40
    13 = 0080			SIO_WRITE      = $80
    14 = 0000			SIO_NONE       = $00
    15 = 0004			FN_OPEN_READ   = 4
    16 = 0000			FN_TRANS_NONE  = 0
    17 = 001E			FN_TIMEOUT     = 30
    18 = 0100			URL_BUF_SIZE   = 256
    19 = 0100			RX_BUF_SIZE    = 256
    20
    21 				; ----------------------------------------------------------------------------
    22 				; fn_open - Open FujiNet connection (url_buffer -> OPEN)
    23 				; Output: C=0 ok, C=1 error
    24 				; ----------------------------------------------------------------------------
    25 3E63			.proc fn_open
    26 3E63 A9 71		        lda #FN_DEVID
    27 3E65 8D 00 03		        sta DDEVIC
    28 3E68 AD 62 3E		        lda fn_cur_unit
    29 3E6B 8D 01 03		        sta DUNIT
    30 3E6E A9 4F		        lda #FN_CMD_OPEN
    31 3E70 8D 02 03		        sta DCOMND
    32 3E73 A9 80		        lda #SIO_WRITE
    33 3E75 8D 03 03		        sta DSTATS
    34 3E78 A9 13		        lda #<url_buffer
    35 3E7A 8D 04 03		        sta DBUFLO
    36 3E7D A9 8D		        lda #>url_buffer
    37 3E7F 8D 05 03		        sta DBUFHI
    38 3E82 A9 1E		        lda #FN_TIMEOUT
    39 3E84 8D 06 03		        sta DTIMLO
    40 3E87 A9 00		        lda #<URL_BUF_SIZE
    41 3E89 8D 08 03		        sta DBYTLO
    42 3E8C A9 01		        lda #>URL_BUF_SIZE
    43 3E8E 8D 09 03		        sta DBYTHI
    44 3E91 A9 04		        lda #FN_OPEN_READ
    45 3E93 8D 0A 03		        sta DAUX1
    46 3E96 A9 00		        lda #FN_TRANS_NONE
    47 3E98 8D 0B 03		        sta DAUX2
    48
    49 3E9B 20 59 E4		        jsr SIOV
    50 3E9E AD 03 03		        lda DSTATS
    51 3EA1 30 02		        bmi ?err
    52 3EA3 18			        clc
    53 3EA4 60			        rts
    54 3EA5 38			?err    sec
    55 3EA6 60			        rts
    56 				.endp
    57
    58 				; ----------------------------------------------------------------------------
    59 				; fn_status - Get FujiNet status (bytes waiting, connected, error)
    60 				; Reads 4-byte DVSTAT: [0]=bytes_lo, [1]=bytes_hi, [2]=connected, [3]=error
    61 				; Error codes: 0=ok, 136($88)=EOF/closed, other=fatal
    62 				; Output: zp_fn_bytes_lo/hi, zp_fn_connected, zp_fn_error, C=0/1
    63 				; ----------------------------------------------------------------------------
    64 3EA7			.proc fn_status
    65 3EA7 A9 71		        lda #FN_DEVID
    66 3EA9 8D 00 03		        sta DDEVIC
    67 3EAC AD 62 3E		        lda fn_cur_unit
    68 3EAF 8D 01 03		        sta DUNIT
    69 3EB2 A9 53		        lda #FN_CMD_STATUS
    70 3EB4 8D 02 03		        sta DCOMND
    71 3EB7 A9 40		        lda #SIO_READ
    72 3EB9 8D 03 03		        sta DSTATS
    73 3EBC A9 EA		        lda #<DVSTAT
    74 3EBE 8D 04 03		        sta DBUFLO
    75 3EC1 A9 02		        lda #>DVSTAT
    76 3EC3 8D 05 03		        sta DBUFHI
    77 3EC6 A9 1E		        lda #FN_TIMEOUT
    78 3EC8 8D 06 03		        sta DTIMLO
    79 3ECB A9 04		        lda #4
    80 3ECD 8D 08 03		        sta DBYTLO
    81 3ED0 A9 00		        lda #0
    82 3ED2 8D 09 03		        sta DBYTHI
    83 3ED5 8D 0A 03		        sta DAUX1
    84 3ED8 8D 0B 03		        sta DAUX2
    85
    86 3EDB 20 59 E4		        jsr SIOV
    87 3EDE AD 03 03		        lda DSTATS
    88 3EE1 30 16		        bmi ?err
    89
    90 3EE3 AD EA 02		        lda DVSTAT
    91 3EE6 85 A1		        sta zp_fn_bytes_lo
    92 3EE8 AD EB 02		        lda DVSTAT+1
    93 3EEB 85 A2		        sta zp_fn_bytes_hi
    94 3EED AD EC 02		        lda DVSTAT+2
    95 3EF0 85 9F		        sta zp_fn_connected
    96 3EF2 AD ED 02		        lda DVSTAT+3
    97 3EF5 85 A0		        sta zp_fn_error
    98
    99 3EF7 18			        clc
   100 3EF8 60			        rts
   101 3EF9 38			?err    sec
   102 3EFA 60			        rts
   103 				.endp
   104
   105 				; ----------------------------------------------------------------------------
   106 				; fn_read - Read data from FujiNet into rx_buffer
   107 				; Uses zp_fn_bytes_lo/hi from fn_status, caps at 255 (8-bit zp_rx_len)
   108 				; Reading 256 would set zp_rx_len=0 (overflow!) — always read max 255
   109 				; DAUX1/DAUX2 must match DBYTLO/DBYTHI (FujiNet requirement)
   110 				; Output: zp_rx_len = bytes read, C=0/1
   111 				; ----------------------------------------------------------------------------
   112 3EFB			.proc fn_read
   113 3EFB A5 A2		        lda zp_fn_bytes_hi
   114 3EFD D0 06		        bne ?max
   115 3EFF A5 A1		        lda zp_fn_bytes_lo
   116 3F01 F0 1E		        beq ?nothing
   117 3F03 D0 0F		        bne ?use_lo
   118
   119 3F05 A9 FF		?max    lda #255                       ; Max 255 bytes (fits in 8-bit rx_len)
   120 3F07 85 A3		        sta zp_rx_len
   121 3F09 8D 08 03		        sta DBYTLO
   122 3F0C A9 00		        lda #0
   123 3F0E 8D 09 03		        sta DBYTHI
   124 3F11 4C 27 3F		        jmp ?do
   125
   126 3F14 85 A3		?use_lo sta zp_rx_len
   127 3F16 8D 08 03		        sta DBYTLO
   128 3F19 A9 00		        lda #0
   129 3F1B 8D 09 03		        sta DBYTHI
   130 3F1E 4C 27 3F		        jmp ?do
   131
   132 3F21			?nothing
   133 3F21 A9 00		        lda #0
   134 3F23 85 A3		        sta zp_rx_len
   135 3F25 18			        clc
   136 3F26 60			        rts
   137
   138 3F27 A9 71		?do     lda #FN_DEVID
   139 3F29 8D 00 03		        sta DDEVIC
   140 3F2C AD 62 3E		        lda fn_cur_unit
   141 3F2F 8D 01 03		        sta DUNIT
   142 3F32 A9 52		        lda #FN_CMD_READ
   143 3F34 8D 02 03		        sta DCOMND
   144 3F37 A9 40		        lda #SIO_READ
   145 3F39 8D 03 03		        sta DSTATS
   146 3F3C A9 13		        lda #<rx_buffer
   147 3F3E 8D 04 03		        sta DBUFLO
   148 3F41 A9 8E		        lda #>rx_buffer
   149 3F43 8D 05 03		        sta DBUFHI
   150 3F46 A9 1E		        lda #FN_TIMEOUT
   151 3F48 8D 06 03		        sta DTIMLO
   152 3F4B AD 08 03		        lda DBYTLO
   153 3F4E 8D 0A 03		        sta DAUX1
   154 3F51 AD 09 03		        lda DBYTHI
   155 3F54 8D 0B 03		        sta DAUX2
   156
   157 3F57 20 59 E4		        jsr SIOV
   158 3F5A AD 03 03		        lda DSTATS
   159 3F5D 30 02		        bmi ?err
   160 3F5F 18			        clc
   161 3F60 60			        rts
   162 3F61 38			?err    sec
   163 3F62 60			        rts
   164 				.endp
   165
   166 				; ----------------------------------------------------------------------------
   167 				; fn_close - Close FujiNet connection
   168 				; ----------------------------------------------------------------------------
   169 3F63			.proc fn_close
   170 3F63 A9 71		        lda #FN_DEVID
   171 3F65 8D 00 03		        sta DDEVIC
   172 3F68 AD 62 3E		        lda fn_cur_unit
   173 3F6B 8D 01 03		        sta DUNIT
   174 3F6E A9 43		        lda #FN_CMD_CLOSE
   175 3F70 8D 02 03		        sta DCOMND
   176 3F73 A9 00		        lda #SIO_NONE
   177 3F75 8D 03 03		        sta DSTATS
   178 3F78 A9 00		        lda #0
   179 3F7A 8D 04 03		        sta DBUFLO
   180 3F7D 8D 05 03		        sta DBUFHI
   181 3F80 8D 08 03		        sta DBYTLO
   182 3F83 8D 09 03		        sta DBYTHI
   183 3F86 8D 0A 03		        sta DAUX1
   184 3F89 8D 0B 03		        sta DAUX2
   185 3F8C A9 1E		        lda #FN_TIMEOUT
   186 3F8E 8D 06 03		        sta DTIMLO
   187
   188 3F91 4C 59 E4		        jmp SIOV
   189 				.endp
