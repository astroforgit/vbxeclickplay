   231 				; ----------------------------------------------------------------------------
   232 				; Macros
   233 				; ----------------------------------------------------------------------------
   234
   235 				; MEMAC B macros with shadow variable for interrupt-safe restore.
   236 				; IMPORTANT: Code using these macros MUST be below $4000!
   237 				; When MEMAC B is active, $4000-$7FFF reads VRAM, not RAM.
   238 				; Interrupt handlers use stubs at page 6 to disable/restore MEMAC B.
   239 				memb_on .macro
   240 				        lda #$80+:1
   241 				        sta zp_memb_shadow     ; shadow FIRST (NMI-safe ordering)
   242 				        ldy #VBXE_MEMAC_B
   243 				        sta (zp_vbxe_base),y
   244 				        .endm
   245
   246 				memb_off .macro
   247 				        lda #0
   248 				        sta zp_memb_shadow     ; shadow FIRST (NMI-safe ordering)
   249 				        ldy #VBXE_MEMAC_B
   250 				        sta (zp_vbxe_base),y
   251 				        .endm
   252
   253 				; Show message on status bar: :1=color, :2=message address
   254 				; Expands to subroutine call (9 bytes) instead of inline (31 bytes)
   255 				status_msg .macro
   256 				        ldy #:1
   257 				        lda #<:2
   258 				        ldx #>:2
   259 				        jsr status_msg_sub
   260 				        .endm
   261
   262 				; Wait N frames (RTCLOK-based delay): :1=frame count
   263 				; Expands to subroutine call (5 bytes) instead of inline (13 bytes)
   264 				wait_frames .macro
   265 				        ldx #:1
   266 				        jsr wait_frames_sub
   267 				        .endm
   268
   269 				blit_start .macro
   270 				        ldy #VBXE_BL_ADR0
   271 				        lda #<:1
   272 				        sta (zp_vbxe_base),y
   273 				        iny
   274 				        lda #>:1
   275 				        sta (zp_vbxe_base),y
   276 				        iny
   277 				        lda #0
   278 				        sta (zp_vbxe_base),y
   279 				        iny
   280 				        lda #1
   281 				        sta (zp_vbxe_base),y
   282 				        .endm
   283
   284 				blit_wait .macro
   285 				        ldy #VBXE_BLITTER
   286 				?bw     lda (zp_vbxe_base),y
   287 				        bne ?bw
   288 				        .endm
