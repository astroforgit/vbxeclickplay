     1 				; ============================================================================
     2 				; FujiNet N: Device SIO Layer
     3 				; ============================================================================
     4
     5 = 0071			FN_DEVID       = $71
     6 = 0001			FN_UNIT        = 1
     7 3E64 01			fn_cur_unit    dta FN_UNIT     ; current N: unit (1=page, 2=image)
     8 = 004F			FN_CMD_OPEN    = 'O'
     9 = 0043			FN_CMD_CLOSE   = 'C'
    10 = 0052			FN_CMD_READ    = 'R'
    11 = 0053			FN_CMD_STATUS  = 'S'
    12 = 0040			SIO_READ       = $40
    13 = 0080			SIO_WRITE      = $80
    14 = 0000			SIO_NONE       = $00
    15 = 0004			FN_OPEN_READ   = 4
    16 = 0000			FN_TRANS_NONE  = 0
    17 = 001E			FN_TIMEOUT     = 30
    18 = 0100			URL_BUF_SIZE   = 256
    19 = 0100			RX_BUF_SIZE    = 256
    20
    21 				; ----------------------------------------------------------------------------
    22 				; fn_open - Open FujiNet connection (url_buffer -> OPEN)
    23 				; Output: C=0 ok, C=1 error
    24 				; ----------------------------------------------------------------------------
    25 3E65			.proc fn_open
    26 3E65 A9 71		        lda #FN_DEVID
    27 3E67 8D 00 03		        sta DDEVIC
    28 3E6A AD 64 3E		        lda fn_cur_unit
    29 3E6D 8D 01 03		        sta DUNIT
    30 3E70 A9 4F		        lda #FN_CMD_OPEN
    31 3E72 8D 02 03		        sta DCOMND
    32 3E75 A9 80		        lda #SIO_WRITE
    33 3E77 8D 03 03		        sta DSTATS
    34 3E7A A9 13		        lda #<url_buffer
    35 3E7C 8D 04 03		        sta DBUFLO
    36 3E7F A9 8D		        lda #>url_buffer
    37 3E81 8D 05 03		        sta DBUFHI
    38 3E84 A9 1E		        lda #FN_TIMEOUT
    39 3E86 8D 06 03		        sta DTIMLO
    40 3E89 A9 00		        lda #<URL_BUF_SIZE
    41 3E8B 8D 08 03		        sta DBYTLO
    42 3E8E A9 01		        lda #>URL_BUF_SIZE
    43 3E90 8D 09 03		        sta DBYTHI
    44 3E93 A9 04		        lda #FN_OPEN_READ
    45 3E95 8D 0A 03		        sta DAUX1
    46 3E98 A9 00		        lda #FN_TRANS_NONE
    47 3E9A 8D 0B 03		        sta DAUX2
    48
    49 3E9D 20 59 E4		        jsr SIOV
    50 3EA0 AD 03 03		        lda DSTATS
    51 3EA3 30 02		        bmi ?err
    52 3EA5 18			        clc
    53 3EA6 60			        rts
    54 3EA7 38			?err    sec
    55 3EA8 60			        rts
    56 				.endp
    57
    58 				; ----------------------------------------------------------------------------
    59 				; fn_status - Get FujiNet status (bytes waiting, connected, error)
    60 				; Reads 4-byte DVSTAT: [0]=bytes_lo, [1]=bytes_hi, [2]=connected, [3]=error
    61 				; Error codes: 0=ok, 136($88)=EOF/closed, other=fatal
    62 				; Output: zp_fn_bytes_lo/hi, zp_fn_connected, zp_fn_error, C=0/1
    63 				; ----------------------------------------------------------------------------
    64 3EA9			.proc fn_status
    65 3EA9 A9 71		        lda #FN_DEVID
    66 3EAB 8D 00 03		        sta DDEVIC
    67 3EAE AD 64 3E		        lda fn_cur_unit
    68 3EB1 8D 01 03		        sta DUNIT
    69 3EB4 A9 53		        lda #FN_CMD_STATUS
    70 3EB6 8D 02 03		        sta DCOMND
    71 3EB9 A9 40		        lda #SIO_READ
    72 3EBB 8D 03 03		        sta DSTATS
    73 3EBE A9 EA		        lda #<DVSTAT
    74 3EC0 8D 04 03		        sta DBUFLO
    75 3EC3 A9 02		        lda #>DVSTAT
    76 3EC5 8D 05 03		        sta DBUFHI
    77 3EC8 A9 1E		        lda #FN_TIMEOUT
    78 3ECA 8D 06 03		        sta DTIMLO
    79 3ECD A9 04		        lda #4
    80 3ECF 8D 08 03		        sta DBYTLO
    81 3ED2 A9 00		        lda #0
    82 3ED4 8D 09 03		        sta DBYTHI
    83 3ED7 8D 0A 03		        sta DAUX1
    84 3EDA 8D 0B 03		        sta DAUX2
    85
    86 3EDD 20 59 E4		        jsr SIOV
    87 3EE0 AD 03 03		        lda DSTATS
    88 3EE3 30 16		        bmi ?err
    89
    90 3EE5 AD EA 02		        lda DVSTAT
    91 3EE8 85 A1		        sta zp_fn_bytes_lo
    92 3EEA AD EB 02		        lda DVSTAT+1
    93 3EED 85 A2		        sta zp_fn_bytes_hi
    94 3EEF AD EC 02		        lda DVSTAT+2
    95 3EF2 85 9F		        sta zp_fn_connected
    96 3EF4 AD ED 02		        lda DVSTAT+3
    97 3EF7 85 A0		        sta zp_fn_error
    98
    99 3EF9 18			        clc
   100 3EFA 60			        rts
   101 3EFB 38			?err    sec
   102 3EFC 60			        rts
   103 				.endp
   104
   105 				; ----------------------------------------------------------------------------
   106 				; fn_read - Read data from FujiNet into rx_buffer
   107 				; Uses zp_fn_bytes_lo/hi from fn_status, caps at 255 (8-bit zp_rx_len)
   108 				; Reading 256 would set zp_rx_len=0 (overflow!) — always read max 255
   109 				; DAUX1/DAUX2 must match DBYTLO/DBYTHI (FujiNet requirement)
   110 				; Output: zp_rx_len = bytes read, C=0/1
   111 				; ----------------------------------------------------------------------------
   112 3EFD			.proc fn_read
   113 3EFD A5 A2		        lda zp_fn_bytes_hi
   114 3EFF D0 06		        bne ?max
   115 3F01 A5 A1		        lda zp_fn_bytes_lo
   116 3F03 F0 1E		        beq ?nothing
   117 3F05 D0 0F		        bne ?use_lo
   118
   119 3F07 A9 FF		?max    lda #255                       ; Max 255 bytes (fits in 8-bit rx_len)
   120 3F09 85 A3		        sta zp_rx_len
   121 3F0B 8D 08 03		        sta DBYTLO
   122 3F0E A9 00		        lda #0
   123 3F10 8D 09 03		        sta DBYTHI
   124 3F13 4C 29 3F		        jmp ?do
   125
   126 3F16 85 A3		?use_lo sta zp_rx_len
   127 3F18 8D 08 03		        sta DBYTLO
   128 3F1B A9 00		        lda #0
   129 3F1D 8D 09 03		        sta DBYTHI
   130 3F20 4C 29 3F		        jmp ?do
   131
   132 3F23			?nothing
   133 3F23 A9 00		        lda #0
   134 3F25 85 A3		        sta zp_rx_len
   135 3F27 18			        clc
   136 3F28 60			        rts
   137
   138 3F29 A9 71		?do     lda #FN_DEVID
   139 3F2B 8D 00 03		        sta DDEVIC
   140 3F2E AD 64 3E		        lda fn_cur_unit
   141 3F31 8D 01 03		        sta DUNIT
   142 3F34 A9 52		        lda #FN_CMD_READ
   143 3F36 8D 02 03		        sta DCOMND
   144 3F39 A9 40		        lda #SIO_READ
   145 3F3B 8D 03 03		        sta DSTATS
   146 3F3E A9 13		        lda #<rx_buffer
   147 3F40 8D 04 03		        sta DBUFLO
   148 3F43 A9 8E		        lda #>rx_buffer
   149 3F45 8D 05 03		        sta DBUFHI
   150 3F48 A9 1E		        lda #FN_TIMEOUT
   151 3F4A 8D 06 03		        sta DTIMLO
   152 3F4D AD 08 03		        lda DBYTLO
   153 3F50 8D 0A 03		        sta DAUX1
   154 3F53 AD 09 03		        lda DBYTHI
   155 3F56 8D 0B 03		        sta DAUX2
   156
   157 3F59 20 59 E4		        jsr SIOV
   158 3F5C AD 03 03		        lda DSTATS
   159 3F5F 30 02		        bmi ?err
   160 3F61 18			        clc
   161 3F62 60			        rts
   162 3F63 38			?err    sec
   163 3F64 60			        rts
   164 				.endp
   165
   166 				; ----------------------------------------------------------------------------
   167 				; fn_close - Close FujiNet connection
   168 				; ----------------------------------------------------------------------------
   169 3F65			.proc fn_close
   170 3F65 A9 71		        lda #FN_DEVID
   171 3F67 8D 00 03		        sta DDEVIC
   172 3F6A AD 64 3E		        lda fn_cur_unit
   173 3F6D 8D 01 03		        sta DUNIT
   174 3F70 A9 43		        lda #FN_CMD_CLOSE
   175 3F72 8D 02 03		        sta DCOMND
   176 3F75 A9 00		        lda #SIO_NONE
   177 3F77 8D 03 03		        sta DSTATS
   178 3F7A A9 00		        lda #0
   179 3F7C 8D 04 03		        sta DBUFLO
   180 3F7F 8D 05 03		        sta DBUFHI
   181 3F82 8D 08 03		        sta DBYTLO
   182 3F85 8D 09 03		        sta DBYTHI
   183 3F88 8D 0A 03		        sta DAUX1
   184 3F8B 8D 0B 03		        sta DAUX2
   185 3F8E A9 1E		        lda #FN_TIMEOUT
   186 3F90 8D 06 03		        sta DTIMLO
   187
   188 3F93 4C 59 E4		        jmp SIOV
   189 				.endp
